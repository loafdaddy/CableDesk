<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  Polkit actions for cabledesk-helper.

  PrepareDirectLink is wired to a real D-Bus method and performs
  CheckAuthorization on every call. Remaining actions stay reserved for
  later mutating methods.
-->
<policyconfig>
  <vendor>CableDesk</vendor>
  <vendor_url>https://github.com/loafdaddy/CableDesk</vendor_url>

  <action id="org.cabledesk.helper.load-thunderbolt-module">
    <description>Load the thunderbolt-net kernel module</description>
    <message>Authentication is required to enable direct USB4/Thunderbolt networking</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.cabledesk.helper.prepare-direct-link">
    <description>Create or repair the CableDesk direct-link network profile</description>
    <message>Authentication is required to configure the direct cable connection</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.cabledesk.helper.install-firewall-policy">
    <description>Install the CableDesk firewall policy for the direct-link interface</description>
    <message>Authentication is required to configure firewall rules for the direct cable connection</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.cabledesk.helper.repair-network-profile">
    <description>Recreate the CableDesk network profile</description>
    <message>Authentication is required to repair the CableDesk network configuration</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
