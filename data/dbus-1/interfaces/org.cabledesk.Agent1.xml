<?xml version="1.0" encoding="UTF-8"?>
<!--
  org.cabledesk.Agent1 — the CableDesk user-session agent interface.

  Owned by cabledesk-agent (a systemd user-session service) on the session bus at
  object path /org/cabledesk/Agent. Version 1: incompatible changes ship as
  org.cabledesk.Agent2.
-->
<node name="/org/cabledesk/Agent">
  <interface name="org.cabledesk.Agent1">
    <property name="Version" type="s" access="read"/>

    <method name="GetState">
      <arg name="state" type="s" direction="out"/>
    </method>

    <!-- Sanitised session snapshot for CLI/UI testing (JSON object). -->
    <method name="GetSessionJson">
      <arg name="session_json" type="s" direction="out"/>
    </method>

    <!--
    Planned for later phases:

    <method name="ListTrustedDevices">
      <arg name="devices_json" type="s" direction="out"/>
    </method>

    <method name="Discover">
      <arg name="timeout_ms" type="u" direction="in"/>
    </method>

    <method name="Pair">
      <arg name="device_id" type="s" direction="in"/>
    </method>

    <method name="Connect">
      <arg name="device_id" type="s" direction="in"/>
    </method>

    <method name="Disconnect"/>

    <method name="Forget">
      <arg name="device_id" type="s" direction="in"/>
    </method>

    <signal name="StateChanged">
      <arg name="state" type="s"/>
    </signal>
    -->
  </interface>
</node>
