<?xml version="1.0" encoding="UTF-8"?>
<!--
  org.cabledesk.Helper1 — the CableDesk privileged system-helper interface.

  Owned by cabledesk-helper (a system systemd service, root-privileged but
  intentionally narrow) on the system bus at object path
  /org/cabledesk/Helper. Version 1; incompatible changes ship as
  org.cabledesk.Helper2 rather than break this one.

  Mutating methods MUST CheckAuthorization against data/polkit-1/actions
  before doing anything — see docs/SECURITY.md.
-->
<node name="/org/cabledesk/Helper">
  <interface name="org.cabledesk.Helper1">
    <property name="Version" type="s" access="read"/>

    <method name="Ping">
      <arg name="reply" type="s" direction="out"/>
    </method>

    <method name="CollectDiagnosticsJson">
      <arg name="diagnostics_json" type="s" direction="out"/>
    </method>

    <!-- Polkit: org.cabledesk.helper.prepare-direct-link.
         Rejects non-direct (Wi-Fi/Ethernet) interface names. -->
    <method name="PrepareDirectLink">
      <arg name="interface_name" type="s" direction="in"/>
    </method>

    <!--
    Planned for later phases:

    <method name="LoadThunderboltNetModule">
      <arg name="ok" type="b" direction="out"/>
    </method>

    <method name="InstallFirewallPolicy"/>

    <method name="RepairNetworkProfile"/>
    -->
  </interface>
</node>
